APP_NAME="Suara OSIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.1.10:8080
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osis_election
DB_USERNAME=osis_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_bin

SESSION_DRIVER=file
SESSION_LIFETIME=5
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_COOKIE=osis_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
SESSION_HTTP_ONLY=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Generated once using php artisan election:teacher-url --generate
TEACHER_KEY=
# Optional absolute path to mysqldump.exe (keep quotes for paths with spaces).
MYSQLDUMP_PATH=mysqldump
# Optional backup destination on separate media, outside public/.
# BACKUP_DIRECTORY="E:/Backup-OSIS"
